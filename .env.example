# --- Unipile (https://dashboardv2.unipile.com) ---
# Create an Application, then an API Key.
UNIPILE_API_KEY=your_unipile_api_key

# Optional. Leave empty to use the browser's connected account.
# Set it only if every visitor should share ONE account.
UNIPILE_ACCOUNT_ID=

# Your Unipile API endpoint. Default: https://api.unipile.com
# If your dashboard shows a DSN like https://api1.unipile.com:13111, use that.
UNIPILE_API_URL=https://api.unipile.com

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=your_openrouter_key

# Free model (must support tool calling). Any ":free" model works.
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Hosted auth callback ---
# Public URL Unipile can reach. localhost will NOT work.
# Local testing: use a tunnel, e.g. https://abc123.ngrok-free.app
PUBLIC_URL=https://example.com

# Shared secret appended to notify_url so random POSTs can't register accounts.
NOTIFY_SECRET=change-this-to-a-long-random-string

# --- Agent ---
MAX_STEPS=20
PORT=3000
